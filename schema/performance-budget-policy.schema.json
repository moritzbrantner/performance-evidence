{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/performance-evidence/schema/performance-budget-policy.schema.json",
  "title": "Performance Evidence Budget Policy",
  "description": "Portable CI policy for applying thresholds to a validated Performance Evidence comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "execution",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_exact_head",
        "automatic_retries"
      ],
      "properties": {
        "require_exact_head": {
          "const": true
        },
        "automatic_retries": {
          "const": 0
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "mode",
        "assertion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "enum": [
                "measurement",
                "amplification"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "mode": {
          "enum": [
            "hard",
            "informational",
            "calibration"
          ]
        },
        "assertion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "maximum"
          ],
          "properties": {
            "kind": {
              "enum": [
                "candidate_max",
                "absolute_regression_max",
                "relative_regression_max"
              ]
            },
            "maximum": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
