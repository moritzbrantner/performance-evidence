{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/performance-evidence/schema/performance-budget-evaluation.schema.json",
  "title": "Performance Evidence Budget Evaluation",
  "description": "Derived evaluation of a budget policy against one validated Performance Evidence comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "policy",
    "comparison",
    "execution",
    "status",
    "summary",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "performance-evidence/budget-evaluation"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_evidence_hash",
        "candidate_source_revision",
        "baseline_evidence_hash",
        "baseline_source_revision",
        "comparability"
      ],
      "properties": {
        "candidate_evidence_hash": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_source_revision": {
          "type": "string",
          "minLength": 1
        },
        "baseline_evidence_hash": {
          "$ref": "#/$defs/sha256"
        },
        "baseline_source_revision": {
          "type": "string",
          "minLength": 1
        },
        "comparability": {
          "enum": [
            "comparable",
            "incomparable"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_head_verified",
        "automatic_retries"
      ],
      "properties": {
        "exact_head_verified": {
          "type": "boolean"
        },
        "automatic_retries": {
          "const": 0
        }
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hard_failures",
        "hard_blocked",
        "informational_exceeded",
        "calibration_exceeded",
        "unavailable"
      ],
      "properties": {
        "hard_failures": {
          "type": "integer",
          "minimum": 0
        },
        "hard_blocked": {
          "type": "integer",
          "minimum": 0
        },
        "informational_exceeded": {
          "type": "integer",
          "minimum": 0
        },
        "calibration_exceeded": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ruleEvaluation"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "measurement",
            "amplification"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "maximum"
      ],
      "properties": {
        "kind": {
          "enum": [
            "candidate_max",
            "absolute_regression_max",
            "relative_regression_max"
          ]
        },
        "maximum": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "absolute_delta",
        "relative_delta",
        "relative_delta_status"
      ],
      "properties": {
        "candidate": {
          "type": [
            "number",
            "null"
          ]
        },
        "absolute_delta": {
          "type": [
            "number",
            "null"
          ]
        },
        "relative_delta": {
          "type": [
            "number",
            "null"
          ]
        },
        "relative_delta_status": {
          "enum": [
            "defined",
            "undefined_zero_baseline",
            "unavailable"
          ]
        }
      }
    },
    "ruleEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "mode",
        "assertion",
        "status",
        "reason",
        "observed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "mode": {
          "enum": [
            "hard",
            "informational",
            "calibration"
          ]
        },
        "assertion": {
          "$ref": "#/$defs/assertion"
        },
        "status": {
          "enum": [
            "pass",
            "exceeded",
            "unavailable",
            "ineligible_for_hard_gate"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed": {
          "$ref": "#/$defs/observed"
        }
      }
    }
  }
}
